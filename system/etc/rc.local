#!/bin/bash
# ROB_AMBER_SAFE_RC_LOCAL=1
# Privileged CAN setup is installed root-owned outside /home/amber. The vendor
# cores remain host-owned artifacts, but they execute only as the amber user so
# replacing a home-directory file cannot turn the recovery sudo rule into root
# code execution.
set -eu

/usr/sbin/ip link set dev lo multicast on
/usr/sbin/ip route replace 224.0.0.0/4 dev lo
/usr/sbin/ip route replace 239.255.76.67/32 dev enp2s0
/usr/local/libexec/rob-amber-init-can
echo "[ AMBER CORE ] CAN UP"
for i in $(/usr/bin/seq 15)
do
  /usr/bin/sleep 1
  echo "[ AMBER CORE ] Waiting Network [$i/15]"
done

/usr/sbin/runuser -u amber -- \
  /usr/bin/env 'LCM_DEFAULT_URL=udpm://239.255.76.67:7667?ttl=10' \
  /usr/bin/nohup /bin/sh -c \
  'cd /home/amber/L-10 && exec ./amber_core_L >core.log 2>&1' &
/usr/sbin/runuser -u amber -- \
  /usr/bin/env 'LCM_DEFAULT_URL=udpm://239.255.76.67:7667?ttl=10' \
  /usr/bin/nohup /bin/sh -c \
  'cd /home/amber/R-11 && exec ./amber_core_R >core.log 2>&1' &
echo "[ AMBER CORE ] MAIN CONTROL CORE UP"
/usr/bin/beep -f 659.2 -r 3 -d 100 -l 100 || true
/usr/bin/beep -f 523.2 -r 1 -d 100 -l 400 || true
exit 0
